{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "steps": {
    "install": {
      "commands": ["pnpm install"]
    },
    "build": {
      "commands": ["pnpm build"]
    }
  },
  "deploy": {
    "startCommand": "cd .medusa/server && pnpm install && pnpm run predeploy && pnpm start"
  }
}
